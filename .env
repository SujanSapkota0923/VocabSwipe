# Copy these into your host's environment settings. Do not commit real values.

DJANGO_DEBUG=0
DJANGO_SECRET_KEY=samir-bhanja-ko-khasai-kaam-xain
DJANGO_ALLOWED_HOSTS=vocab.sujansapkota07.com.np,www.vocab.sujansapkota07.com.np
DJANGO_CSRF_TRUSTED_ORIGINS=https://vocab.sujansapkota07.com.np,https://www.vocab.sujansapkota07.com.np

# Set to 0 when nginx, Cloudflare or the platform already forces HTTPS
DJANGO_SECURE_SSL_REDIRECT=1

# Required in production: the database must live on a persistent disk, otherwise
# every deploy replaces the code directory and all uploaded word lists are lost.
DJANGO_DB_PATH=/var/lib/vocabswipe/db.sqlite3
